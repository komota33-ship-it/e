static func for_floor(number: int) -> Dictionary:
	if number < 2 or number > 50 or [5, 10, 15, 20, 25, 30].has(number):
		return {}
	if (number * 37 + 11) % 10 >= 4:
		return {}
	var ordinal := 0
	for earlier in range(50, number, -1):
		if not [5, 10, 15, 20, 25, 30].has(earlier) and (earlier * 37 + 11) % 10 < 4:
			ordinal += 1
	return EVENTS[ordinal % EVENTS.size()].duplicate(true)
